{
  "name": "branded-short-links-project",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "prod": "turbo run prod",
    "build": "turbo run build --concurrency=2",
    "check": "turbo run check --concurrency=2 && eslint . --max-warnings=0 && nova utility type-check --project tsconfig.config.json && nova utility type-check --project tsconfig.scripts.json",
    "deploy": "turbo run deploy --concurrency=2",
    "clean": "turbo run clean",
    "manage": "npm run manage --workspace packages/branded-short-links",
    "tail": "node ./scripts/tail-logs.mjs",
    "changelog": "nova utility changelog",
    "recipes": "nova utility run-recipes --replace-file",
    "postinstall": "node ./scripts/link-nova.mjs"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "workspaces": [
    "./apps/*",
    "./packages/*"
  ],
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "^22 || ^24"
  },
  "devDependencies": {
    "@cbnventures/nova": "0.25.0",
    "@types/node": "26.2.0",
    "eslint": "9.39.3",
    "jiti": "2.7.0",
    "prompts": "2.4.2",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "webpack": ">=5.95.0 <5.106.0"
  }
}
